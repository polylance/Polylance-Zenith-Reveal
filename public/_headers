# Cloudflare Pages Security & Cache Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://polylancezenith.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  Access-Control-Expose-Headers: Date
  Cache-Control: public, max-age=0, must-revalidate

# Immutable assets caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache favicons, brand logos, OG image, and AI/manifest files for crawlers (Google Favicon, Bing, LLMs)
/favicon.ico
  Cache-Control: public, max-age=86400

/favicon-16.png
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

/favicon-48.png
  Cache-Control: public, max-age=86400

/favicon-96.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/android-chrome-192x192.png
  Cache-Control: public, max-age=86400

/android-chrome-512x512.png
  Cache-Control: public, max-age=86400

/android-chrome-maskable-512x512.png
  Cache-Control: public, max-age=86400

/logo.png
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600


